{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition",
                "ecs:DescribeTaskDefinition",
                "ecs:DeregisterTaskDefinition",
                "ecs:TagResource",
                "ecs:UntagResource",
                "ecs:ListTagsForResource"
            ],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": [
                "arn:aws:iam::623924715578:role/amazon-be-task-role",
                "arn:aws:iam::623924715578:role/amazon-fe-task-role",
                "arn:aws:iam::623924715578:role/ecsTaskExecutionRole"
            ]
        }
    ]
}