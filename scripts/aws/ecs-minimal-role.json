{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition",
                "ecs:DescribeTaskDefinition",
                "ecs:DeregisterTaskDefinition",
                "ecs:TagResource",
                "ecs:UntagResource",
                "ecs:ListTagsForResource",
                "ecs:ListTaskDefinitions"
            ],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": [
                "ecs:UpdateService",
                "ecs:DescribeServices"
            ],
            "Resource": [
                "arn:aws:ecs:ap-southeast-1:776364313491:service/shopping-assistant-cluster/amazon-be-service",
                "arn:aws:ecs:ap-southeast-1:776364313491:service/shopping-assistant-cluster/amazon-fe-service"
            ]
        },
        {
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": [
                "arn:aws:iam::776364313491:role/amazon-be-task-role",
                "arn:aws:iam::776364313491:role/amazon-fe-task-role",
                "arn:aws:iam::776364313491:role/ecsTaskExecutionRole"
            ]
        },
        {
            "Effect": "Allow",
            "Action": "secretsmanager:DescribeSecret",
            "Resource": "arn:aws:secretsmanager:ap-southeast-1:776364313491:secret:shopping-assistant/*"
        }
    ]
}